FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libpango1.0-dev \
    ffmpeg \
    sox \
    libsox-fmt-all \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/opt/upcurved-venv \
    PYTHONPATH=/app \
    PATH=/opt/upcurved-venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    APP_MODE=desktop-local \
    UPCURVED_STORAGE_DIR=/data/storage \
    UPCURVED_DESKTOP_STATE_DIR=/data/state

COPY backend/pyproject.toml backend/uv.lock /app/backend/
RUN cd /app/backend && uv sync --frozen --no-install-project

COPY backend /app/backend

RUN python -c "import cairo, numpy, scipy, manim, manim_voiceover, edge_tts; from backend.tts.manim_service import EdgeTTSService; import backend.api.main; print('BACKEND CONTAINER SMOKE TEST OK')"

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=12 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
